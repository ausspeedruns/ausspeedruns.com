{
	"name": "ausspeedruns-v2",
	"version": "1.0.0",
	"description": "AusSpeedruns website and event platform, built with Payload CMS and Next.js",
	"license": "MIT",
	"type": "module",
	"imports": {
		"#payload-config": "./src/payload.config.ts",
		"#*": "./src/*"
	},
	"scripts": {
		"build": "next build",
		"postbuild": "next-sitemap --config next-sitemap.config.cjs",
		"dev": "next dev",
		"dev:prod": "rm -rf .next && pnpm build && pnpm start",
		"email:dev": "email dev --dir src/emails",
		"format": "oxfmt",
		"generate:importmap": "payload generate:importmap",
		"generate:types": "payload generate:types",
		"ii": "pnpm --ignore-workspace install",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"payload": "payload",
		"reinstall": "rm -rf node_modules && rm pnpm-lock.yaml && pnpm --ignore-workspace install",
		"start": "next start",
		"test": "pnpm run test:int && pnpm run test:e2e",
		"test:e2e": "pnpm exec playwright test --config=playwright.config.ts",
		"test:int": "vitest run --config ./vitest.config.mts",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@date-fns/tz": "^1.5.0",
		"@dnd-kit/core": "6.3.1",
		"@dnd-kit/sortable": "10.0.0",
		"@dnd-kit/utilities": "3.2.2",
		"@mantine/core": "^9.8.1",
		"@mantine/dates": "^9.8.1",
		"@mantine/form": "^9.8.1",
		"@mantine/hooks": "^9.8.1",
		"@mantine/notifications": "^9.8.1",
		"@marsidev/react-turnstile": "^1.6.3",
		"@payloadcms/admin-bar": "3.93.0",
		"@payloadcms/db-postgres": "3.93.0",
		"@payloadcms/email-nodemailer": "3.93.0",
		"@payloadcms/live-preview-react": "3.93.0",
		"@payloadcms/next": "3.93.0",
		"@payloadcms/plugin-form-builder": "3.93.0",
		"@payloadcms/plugin-nested-docs": "3.93.0",
		"@payloadcms/plugin-redirects": "3.93.0",
		"@payloadcms/plugin-search": "3.93.0",
		"@payloadcms/plugin-seo": "3.93.0",
		"@payloadcms/richtext-lexical": "3.93.0",
		"@payloadcms/storage-azure": "3.93.0",
		"@payloadcms/ui": "3.93.0",
		"@react-email/components": "^1.0.12",
		"bcryptjs": "^3.0.3",
		"clsx": "^2.1.1",
		"date-fns": "^4.4.0",
		"dotenv": "18.0.10",
		"graphql": "^17.1.0",
		"nanoid": "^6.0.2",
		"next": "16.4.6",
		"next-sitemap": "^4.2.3",
		"papaparse": "^5.7.1",
		"payload": "3.93.0",
		"pg": "^8.23.1",
		"pixelarticons": "^2.4.2",
		"prism-react-renderer": "^2.4.1",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"react-hook-form": "7.92.0",
		"react-responsive-carousel": "^3.2.23",
		"server-only": "^0.0.1",
		"sharp": "0.35.5",
		"stripe": "^23.1.0",
		"zod": "^4.6.7",
		"zustand": "^5.1.0"
	},
	"devDependencies": {
		"@playwright/test": "1.65.1",
		"@react-email/preview-server": "5.2.10",
		"@react-email/ui": "6.11.13",
		"@svgr/webpack": "^8.1.0",
		"@types/node": "26.6.6",
		"@types/papaparse": "^5.5.2",
		"@types/pg": "^8.23.1",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@vitejs/plugin-react": "6.3.0",
		"jsdom": "31.0.1",
		"oxfmt": "^0.78.0",
		"oxlint": "^1.93.0",
		"postcss": "^8.5.33",
		"postcss-preset-mantine": "^1.18.0",
		"postcss-simple-vars": "^7.0.1",
		"react-email": "6.11.13",
		"typescript": "7.0.2",
		"vitest": "5.1.0"
	},
	"engines": {
		"node": ">=24 || >=26",
		"pnpm": "^12"
	}
}
