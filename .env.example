# Database connection string (Azure Database for PostgreSQL requires ?sslmode=require)
DATABASE_URI=postgresql://127.0.0.1:5432/your-database-name
# Optional: max connections in the pool (default 10)
# DATABASE_POOL_MAX=10
# Pending migrations run on server start in production. Set to true to skip them, e.g. when running a local
# production build against a dev database whose schema was created with push.
# DISABLE_PROD_MIGRATIONS=true

# Used to encrypt JWT tokens. Use a long random string in production (e.g. openssl rand -hex 32)
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Used to configure CORS, format links and more. No trailing slash
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Secret external schedulers can send (Authorization: Bearer <secret>) to /api/payload-jobs/run.
# Jobs (e.g. scheduled publish) also auto-run in-process every minute; set DISABLE_JOBS_AUTORUN=true to turn that off.
CRON_SECRET=YOUR_CRON_SECRET_HERE

# Used to validate preview requests
PREVIEW_SECRET=YOUR_SECRET_HERE

# Stripe API keys (replace with actual keys)
# The webhook endpoint is /api/stripe/webhook and must be subscribed to: checkout.session.completed,
# checkout.session.async_payment_succeeded, checkout.session.async_payment_failed, checkout.session.expired,
# charge.refunded, charge.dispute.created (see src/utilities/payments/stripeWebhook.ts)
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# NextJS
NEXT_PUBLIC_URL=http://localhost:3000

# Email (SMTP via nodemailer). When SMTP_HOST is unset, emails are only logged to the console.
# Azure Communication Services: SMTP_HOST=smtp.azurecomm.net, SMTP_PORT=587, SMTP_USER=<username>, SMTP_PASS=<Entra app secret>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM_ADDRESS=noreply@ausspeedruns.com
EMAIL_FROM_NAME=AusSpeedruns

# Cloudflare Turnstile bot check on the sign up and forgot password forms (https://dash.cloudflare.com/?to=/:account/turnstile).
# Read at runtime. Outside production, unset keys fall back to Cloudflare's always-pass test keys;
# in production, those forms refuse to submit until both are set.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Azure Blob Storage for media uploads. When AZURE_STORAGE_CONNECTION_STRING is unset, uploads are stored in public/media.
# The container must allow anonymous blob read access, as media is served directly from Blob (or a CDN in front of it).
# AZURE_STORAGE_ACCOUNT_BASEURL is also needed at build time so next/image allows the host.
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER_NAME=media
AZURE_STORAGE_ACCOUNT_BASEURL=https://<account>.blob.core.windows.net
AZURE_STORAGE_ALLOW_CONTAINER_CREATE=false
