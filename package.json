	},
	"devDependencies": {
		"@playwright/test": "1.61.0",
		"@react-email/preview-server": "5.2.10",
		"@svgr/webpack": "^8.1.0",
		"@testing-library/react": "16.3.2",
		"@types/escape-html": "^1.0.4",
		"@types/node": "26.0.0",
		"@types/pg": "^8.20.0",
		"@types/react": "19.2.17",
		"@types/react-dom": "19.2.3",
		"@vitejs/plugin-react": "6.0.2",
		"copyfiles": "^2.4.1",
		"jsdom": "29.1.1",
		"oxfmt": "^0.55.0",
		"oxlint": "^1.70.0",
		"playwright": "1.61.0",
		"playwright-core": "1.61.0",
		"postcss": "^8.5.15",
		"postcss-preset-mantine": "^1.18.0",
		"postcss-simple-vars": "^7.0.1",
		"prettier": "^3.8.4",
		"react-email": "6.6.3",
		"typescript": "6.0.3",
		"vite-tsconfig-paths": "6.1.1",
		"vitest": "4.1.9"
	},
	"engines": {
		"node": "^18.20.2 || >=20.9.0",
		"pnpm": "^9 || ^10"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"sharp",
			"esbuild",
			"unrs-resolver"
		]
	}
