{
	"name": "ausspeedruns-v2",
	"version": "1.0.0",
	"description": "Website template for Payload",
	"license": "MIT",
	"type": "module",
	"imports": {
		"#payload-config": "./src/payload.config.ts",
		"#*": "./src/*"
	},
	"scripts": {
		"build": "cross-env NODE_OPTIONS=--no-deprecation next build --webpack",
		"postbuild": "next-sitemap --config next-sitemap.config.cjs",
		"dev": "cross-env NODE_OPTIONS=--no-deprecation next dev --webpack",
		"dev:prod": "cross-env NODE_OPTIONS=--no-deprecation rm -rf .next && pnpm build && pnpm start",
		"generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
		"generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
		"ii": "cross-env NODE_OPTIONS=--no-deprecation pnpm --ignore-workspace install",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
		"reinstall": "cross-env NODE_OPTIONS=--no-deprecation rm -rf node_modules && rm pnpm-lock.yaml && pnpm --ignore-workspace install",
		"start": "cross-env NODE_OPTIONS=--no-deprecation next start",
		"test": "pnpm run test:int && pnpm run test:e2e",
		"test:e2e": "cross-env NODE_OPTIONS=\"--no-deprecation --no-experimental-strip-types\" pnpm exec playwright test --config=playwright.config.ts",
		"test:int": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts"
	},
	"dependencies": {
		"@payloadcms/admin-bar": "3.77.0",
		"@payloadcms/db-postgres": "3.77.0",
		"@payloadcms/live-preview-react": "3.77.0",
		"@payloadcms/next": "3.77.0",
		"@payloadcms/plugin-form-builder": "3.77.0",
		"@payloadcms/plugin-nested-docs": "3.77.0",
		"@payloadcms/plugin-redirects": "3.77.0",
		"@payloadcms/plugin-search": "3.77.0",
		"@payloadcms/plugin-seo": "3.77.0",
		"@payloadcms/richtext-lexical": "3.77.0",
		"@payloadcms/ui": "3.77.0",
		"@radix-ui/react-checkbox": "^1.3.3",
		"@radix-ui/react-label": "^2.1.8",
		"@radix-ui/react-select": "^2.2.6",
		"@radix-ui/react-slot": "^1.2.4",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cross-env": "^10.1.0",
		"dotenv": "17.3.1",
		"geist": "^1.7.0",
		"graphql": "^16.12.0",
		"lucide-react": "^0.575.0",
		"next": "16.2.0-canary.62",
		"next-sitemap": "^4.2.3",
		"payload": "3.77.0",
		"pg": "^8.18.0",
		"prism-react-renderer": "^2.4.1",
		"react": "19.2.4",
		"react-dom": "19.2.4",
		"react-hook-form": "7.71.2",
		"react-responsive-carousel": "^3.2.23",
		"sharp": "0.34.5"
	},
	"devDependencies": {
		"@playwright/test": "1.58.2",
		"@svgr/webpack": "^8.1.0",
		"@testing-library/react": "16.3.2",
		"@types/escape-html": "^1.0.4",
		"@types/node": "25.3.0",
		"@types/pg": "^8.16.0",
		"@types/react": "19.2.14",
		"@types/react-dom": "19.2.3",
		"@vitejs/plugin-react": "5.1.4",
		"copyfiles": "^2.4.1",
		"jsdom": "27.3.0",
		"oxfmt": "^0.35.0",
		"oxlint": "^1.50.0",
		"playwright": "1.58.2",
		"playwright-core": "1.58.2",
		"prettier": "^3.8.1",
		"typescript": "5.9.3",
		"vite-tsconfig-paths": "6.1.1",
		"vitest": "4.0.18"
	},
	"engines": {
		"node": "^18.20.2 || >=20.9.0",
		"pnpm": "^9 || ^10"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"sharp",
			"esbuild",
			"unrs-resolver"
		]
	}
}
