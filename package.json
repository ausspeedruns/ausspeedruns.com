		"dayjs": "^1.11.21",
		"dotenv": "17.4.2",
		"geist": "^1.7.2",
		"graphql": "^17.0.1",
		"lucide-react": "^1.21.0",
		"nanoid": "^5.1.14",
		"next": "16.2.9",
		"next-sitemap": "^4.2.3",
		"payload": "3.85.1",
		"pg": "^8.22.0",
		"pixelarticons": "^2.1.2",
		"prism-react-renderer": "^2.4.1",
		"react": "19.2.7",
